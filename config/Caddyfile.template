{
    admin off
}

TEMPLATE_HOST_NAME, www.TEMPLATE_HOST_NAME {
    @php path *.php
    respond @php 404

    handle /robots.txt {
        root * /static/findshows
        file_server
    }

    handle_path /static/* {
        root * /static/
        file_server
    }

    handle_path /media/* {
        root * /media/
        file_server
    }

    reverse_proxy web:8000

}
