{
    admin off
}

TEMPLATE_HOST_NAME, www.TEMPLATE_HOST_NAME {
    handle_path /favicon.ico {
        redir /static/findshows/icons/favicon.ico
    }

    handle_path /static/* {
        root * /static/
        file_server
    }

    handle_path /media/* {
        root * /media/
        file_server
    }

    reverse_proxy web:8000

}
